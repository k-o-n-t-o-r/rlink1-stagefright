# Copy to config.env for machine-local overrides.

# Patched qemu-linaro checkout created by ./build-qemu.sh.
# QEMU_SRC=/absolute/path/to/qemu-linaro

# Docker toolchain image and container name.
# BUILD_IMAGE=rlink-qemu-build:18.04
# NAME=rlinkq

# Host ports. Set VNC_PORT=0 or GDB_PORT=0 to disable those listeners.
# SHELL_PORT=2323
# VNC_PORT=5900
# GDB_PORT=0

# Keep guest writes in sd.img. The safe default (0) uses QEMU -snapshot.
# PERSIST=1

# Internal eMMC size. This is separate from the removable-card SD_SIZE.
# EMMC_SIZE=2G

# Boot wait timeout and minimum guest uptime checked by the smoke test.
# BOOT_TIMEOUT=240
# SMOKE_STABILITY_SECONDS=130

# Runtime removable card defaults. SD_IMAGE must remain under qemu/ because
# that directory is the one mounted into the running QEMU container.
# SD_IMAGE=removable.img
# SD_SIZE=1G
# SD_LABEL=RLINKSD
# Physical SD CID presented by the emulated SMSC USB card reader. Keep the
# synthetic default unless using licensed media tied to an authorized card.
# SD_CID=00000000000000000000000000000000
# SD_TIMEOUT=60

# Factory/EOL language byte exposed by the emulated 8 KiB I2C EEPROM.
# The default is 3 (German). Other firmware-defined values include 0=French,
# 1=English, 2=Italian, 4=Spanish, and 255=unsupported/factory fallback.
# EOL_MMI_LANGUAGE=3

# Set bit 6 in the factory Ecu byte, enabling the production Android Auto
# feature gate. The default is disabled to match the base firmware image.
# EOL_ANDROID_AUTO=1

# Model the I2C TSC2007 and turn VNC pointer clicks into Android touches.
# TOUCHSCREEN=1

# Opt in to physical USB passthrough. This bind-mounts host usbfs into the
# QEMU container and grants USB character-device access; disabled by default.
# USB_PASSTHROUGH=1
# Optional defaults for `usb-attach`. Use the stable physical path reported by
# `lsusb -t`; Android Accessory mode changes VID/PID and device address.
# USB_PHONE_BUS=1
# USB_PHONE_PORT=1.1
# USB_PHONE_GUEST_BUS=usb-bus.2

# Optional board revision and alternate source rootfs.
# RLINK_SYSREV=0x12
# ROOTFS_SOURCE=/path/to/rootfs.img.new

# Additional kernel arguments may be appended like this:
# CMDLINE_EXTRA="loglevel=7"
