+static struct arm_boot_info beagle_binfo;
+
+#define OMAP3_CM_BASE 0x48004000
+
+/* OMAP EHCI INSNREG00..05 (0x90..0xa4): the ULPI viewport in INSNREG05 must
+ * read back with the control bit clear or the kernel BUG()s; report every
+ * access as completed with data 0. */
+static uint64_t omap_ehci_insnreg_read(void *opaque, hwaddr addr, unsigned size)
+{
+    return 0;
+}
+
+static void omap_ehci_insnreg_write(void *opaque, hwaddr addr, uint64_t val,
+                                    unsigned size)
+{
+}
+
+static const MemoryRegionOps omap_ehci_insnreg_ops = {
+    .read = omap_ehci_insnreg_read,
+    .write = omap_ehci_insnreg_write,
+    .endianness = DEVICE_NATIVE_ENDIAN,
+};
+
+static void cm_rmw(uint32_t off, uint32_t mask, uint32_t val)
+{
+    hwaddr a = OMAP3_CM_BASE + off;
+    uint32_t v = ldl_le_phys(&address_space_memory, a);
+    stl_le_phys(&address_space_memory, a, (v & ~mask) | val);
+}
+
+/* Runs after the SoC reset: emulate what x-loader/u-boot leave behind when
+ * we jump straight into the kernel.
+ *  - GPMC CS0 comes out of reset as CSVALID at base 0/16MB, which
+ *    gpmc_mem_init() cannot reserve (BUG()).
+ *  - The DPLLs come out of reset in bypass/stop; the kernel expects them
+ *    programmed and locked (u-boot prcm_init() for OMAP36xx, 26 MHz sys_clk),
+ *    otherwise every dpll4 enable spins 1M x udelay(1) and fails. */
+static void beagle_kernel_reset(void *opaque)
+{
+    stl_le_phys(&address_space_memory, 0x6e000078, 0xf00); /* GPMC_CONFIG7_0 */
+
+    /* DPLL3 core 400 MHz: M=200 N=12 M2=1, L3=/2 L4=/2 */
+    cm_rmw(0x1140, 0x001f0000, 2 << 16);                  /* CLKSEL1_EMU M3X2 */
+    cm_rmw(0x0d40, 0xffff7f40, (1 << 27) | (200 << 16) | (12 << 8));
+    cm_rmw(0x0a40, 0x00000f3f, (3 << 8) | (2 << 4) | (2 << 2) | 2);
+    cm_rmw(0x0b40, 0x7, 5);                               /* CLKSEL_SGX */
+    cm_rmw(0x0c40, 0x6, 2 << 1);                          /* CLKSEL_WKUP */
+    cm_rmw(0x0d00, 0xf7, 0x7);                            /* lock core */
+    /* DPLL4 per 864 MHz: M=432 N=12, M2=9 M3=16 M4=9 M5=4 M6=3 */
+    cm_rmw(0x1140, 0x3f000000, 3 << 24);
+    cm_rmw(0x0f40, 0x3f, 4);
+    cm_rmw(0x0e40, 0x3f3f, (16 << 8) | 9);
+    cm_rmw(0x0d48, 0x1f, 9);
+    cm_rmw(0x0d44, 0x000fff7f, (432 << 8) | 12);
+    cm_rmw(0x0a40, 0x3000, 1 << 12);
+    cm_rmw(0x0d00, 0x70000, 7 << 16);                     /* lock per */
+    /* DPLL5 per2 120 MHz: M=443 N=11 M2=8 */
+    cm_rmw(0x0d50, 0x1f, 8);
+    cm_rmw(0x0d4c, 0x7ff7f, (443 << 8) | 11);
+    cm_rmw(0x0d04, 0x7, 7);
+    /* DPLL2 iva2 260 MHz: M=10 N=0 M2=1 */
+    cm_rmw(0x0044, 0x1f, 1);
+    cm_rmw(0x0040, 0x7ff7f, 10 << 8);
+    cm_rmw(0x0004, 0x7, 7);
+    /* DPLL1 mpu 600 MHz: M=300 N=12 M2=1 */
+    cm_rmw(0x0944, 0x1f, 1);
+    cm_rmw(0x0940, 0x7ff7f, (300 << 8) | 12);
+    cm_rmw(0x0904, 0x7, 7);
+}
