     if (dsd) {
         omap3_mmc_attach(s->cpu->omap3_mmc[0], blk_by_legacy_dinfo(dsd),
@@ -93,7 +171,63 @@ static void beagle_common_init(MachineState *machine,
      */
     s->ddc = i2c_create_slave(omap_i2c_bus(s->cpu->i2c[2]), "i2c-ddc", 0x50);
 
