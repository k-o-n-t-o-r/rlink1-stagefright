+};
+
+static int tsc2007_init(I2CSlave *i2c)
+{
+    TSC2007State *s = TSC2007(i2c);
+
+    qdev_init_gpio_out(&i2c->qdev, &s->penirq, 1);
+    qemu_add_mouse_event_handler(tsc2007_touch_event, s, 1,
+                                 "QEMU R-LINK TSC2007 Touchscreen");
+    return 0;
+}
+
+static void tsc2007_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    I2CSlaveClass *k = I2C_SLAVE_CLASS(klass);
+
+    k->init = tsc2007_init;
+    k->event = tsc2007_event;
+    k->recv = tsc2007_rx;
+    k->send = tsc2007_tx;
+    dc->reset = tsc2007_reset;
+    dc->vmsd = &vmstate_tsc2007;
+}
+
+static const TypeInfo tsc2007_info = {
+    .name = TYPE_TSC2007,
+    .parent = TYPE_I2C_SLAVE,
+    .instance_size = sizeof(TSC2007State),
+    .class_init = tsc2007_class_init,
+};
+
+static void tsc2007_register_types(void)
+{
+    type_register_static(&tsc2007_info);
+}
