diff --git a/hw/i2c/ddc.c b/hw/i2c/ddc.c
index cb516bfd8..480857e77 100644
--- a/hw/i2c/ddc.c
+++ b/hw/i2c/ddc.c
@@ -215,30 +215,100 @@ static void build_edid_blob(const edid_data *edid, uint8_t *blob)
 
 
 
-/* A simple I2C slave which just returns the contents of its EDID blob. */
+/* A simple I2C slave which normally returns monitor EDID data.  The R-LINK
+ * kernel describes the device at this address as an 8 KiB 24C64 EEPROM and
+ * its EOL library reads the factory MMI language from byte 0x103.  When
+ * RLINK_EEPROM_MMI_LANGUAGE is present, provide the two-byte-addressed,
+ * writable EEPROM expected by that firmware instead of the one-byte DDC
+ * device.  Keeping both behaviours lets the generic Beagle machine retain
+ * its historical monitor model when it is not used for R-LINK. */
 
 #define TYPE_I2CDDC "i2c-ddc"
 #define I2CDDC(obj) OBJECT_CHECK(I2CDDCState, (obj), TYPE_I2CDDC)
+#define RLINK_EEPROM_SIZE 8192
+#define RLINK_EEPROM_MMI_LANGUAGE_OFFSET 0x103
+#define RLINK_EEPROM_ECU_OFFSET 0x112
+#define RLINK_EEPROM_ECU_ANDROID_AUTO 0x40
+#define RLINK_EEPROM_TOUCH_CAL_OFFSET 0x1250
 
 typedef struct I2CDDCState {
     I2CSlave parent_obj;
     int firstbyte;
-    uint8_t reg;
+    uint16_t reg;
     uint8_t edid_blob[128];
+    int rlink_eeprom;
+    int address_bytes;
+    int ddc_read;
+    uint8_t address[2];
+    uint8_t eeprom_blob[RLINK_EEPROM_SIZE];
 } I2CDDCState;
 
+static void build_rlink_eeprom(I2CDDCState *s, uint8_t language,
+                               bool android_auto)
+{
+    static const int32_t touch_calibration[7] = {
+        -13517, 26, 53414312, 44, -8383, 32074952, 65536
+    };
+    unsigned int page, half, i, edid_offset;
+
+    /* Preserve the bytes that the old one-byte DDC model exposed through
+     * Linux's 24C64 driver, then replace the factory settings that QEMU
+     * deliberately models. */
+    for (page = 0; page < RLINK_EEPROM_SIZE / 256; page++) {
+        for (half = 0; half < 2; half++) {
+            for (i = 0; i < 128; i++) {
+                edid_offset = page + 1 + i;
+                s->eeprom_blob[page * 256 + half * 128 + i] =
+                    edid_offset < sizeof(s->edid_blob) ?
+                    s->edid_blob[edid_offset] : 0;
+            }
+        }
+    }
+    s->eeprom_blob[RLINK_EEPROM_MMI_LANGUAGE_OFFSET] = language;
+    if (android_auto) {
+        s->eeprom_blob[RLINK_EEPROM_ECU_OFFSET] |=
+            RLINK_EEPROM_ECU_ANDROID_AUTO;
+    }
+    for (i = 0; i < ARRAY_SIZE(touch_calibration); i++) {
+        uint32_t value = touch_calibration[i];
+        unsigned int offset = RLINK_EEPROM_TOUCH_CAL_OFFSET + i * 4;
+
+        s->eeprom_blob[offset] = value;
+        s->eeprom_blob[offset + 1] = value >> 8;
+        s->eeprom_blob[offset + 2] = value >> 16;
+        s->eeprom_blob[offset + 3] = value >> 24;
+    }
+}
+
 static void i2c_ddc_reset(DeviceState *ds)
 {
     I2CDDCState *s = I2CDDC(ds);
     s->firstbyte = 0;
+    s->address_bytes = 0;
+    s->ddc_read = 0;
     s->reg = 0;
 }
 
 static void i2c_ddc_event(I2CSlave *i2c, enum i2c_event event)
 {
     I2CDDCState *s = I2CDDC(i2c);
+
+    if (!s->rlink_eeprom) {
+        if (event == I2C_START_SEND) {
+            s->firstbyte = 1;
+        }
+        return;
+    }
+
     if (event == I2C_START_SEND) {
-        s->firstbyte = 1;
+        s->address_bytes = 0;
+        s->ddc_read = 0;
+    } else if (event == I2C_START_RECV) {
+        s->ddc_read = s->address_bytes == 1;
+        if (s->ddc_read) {
+            /* Also provide valid EDID for a one-byte-addressed DDC reader. */
+            s->reg = s->address[0];
+        }
     }
 }
 
