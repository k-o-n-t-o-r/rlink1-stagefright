+                              qdev_get_gpio_in(s->cpu->gpio, 54));
+    }
+
     omap_lcd_panel_attach(s->cpu->dss);
+
+    /* OMAP3 EHCI host controller is not modelled by qemu-linaro; the R-Link
+     * kernel BUG()s when the ULPI viewport never completes. A generic sysbus
+     * EHCI (caps at 0x0, opregs at 0x10, like OMAP) reads 0 for INSNREG05. */
+    {
+        DeviceState *ehci = qdev_create(NULL, "exynos4210-ehci-usb");
+        qdev_init_nofail(ehci);
+        memory_region_add_subregion_overlap(sysmem, 0x48064800,
+            sysbus_mmio_get_region(SYS_BUS_DEVICE(ehci), 0), 1);
+        sysbus_connect_irq(SYS_BUS_DEVICE(ehci), 0,
+            qdev_get_gpio_in(s->cpu->ih[0], OMAP_INT_3XXX_EHCI_IRQ));
+        MemoryRegion *insn = g_new(MemoryRegion, 1);
+        memory_region_init_io(insn, NULL, &omap_ehci_insnreg_ops, NULL,
+                              "omap-ehci-insnreg", 0x20);
+        memory_region_add_subregion_overlap(sysmem, 0x48064800 + 0x90, insn, 2);
+    }
+
+    /* -kernel: boot a Linux kernel directly instead of the OMAP3 boot ROM.
+     * RLINK_MACHID, RLINK_SYSREV, RLINK_FDT[_ADDR] env vars feed the
+     * TomTom-specific ATAGs (see hw/arm/boot.c). */
+    if (machine->kernel_filename) {
+        const char *fdt = getenv("RLINK_FDT");
+        beagle_binfo.ram_size = ram_size;
+        beagle_binfo.kernel_filename = machine->kernel_filename;
+        beagle_binfo.kernel_cmdline = machine->kernel_cmdline;
+        beagle_binfo.initrd_filename = machine->initrd_filename;
+        beagle_binfo.loader_start = OMAP3_Q2_BASE;
+        beagle_binfo.board_id = getenv("RLINK_MACHID") ?
+            strtoul(getenv("RLINK_MACHID"), NULL, 0) : 0x60a;
+        beagle_binfo.rlink_sysrev = getenv("RLINK_SYSREV") ?
+            strtoul(getenv("RLINK_SYSREV"), NULL, 0) : 0;
+        if (fdt) {
+            int n;
+            beagle_binfo.rlink_fdt_addr = getenv("RLINK_FDT_ADDR") ?
+                strtoul(getenv("RLINK_FDT_ADDR"), NULL, 0) :
+                OMAP3_Q2_BASE + ram_size - 0x1000000;
+            n = load_image_targphys(fdt, beagle_binfo.rlink_fdt_addr, 1 << 20);
+            if (n < 0) {
+                hw_error("could not load RLINK_FDT %s", fdt);
+            }
+            beagle_binfo.rlink_fdt_size = n;
+        }
+        arm_load_kernel(s->cpu->cpu, &beagle_binfo);
