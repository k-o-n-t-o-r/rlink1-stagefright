diff --git a/hw/input/tsc2007.c b/hw/input/tsc2007.c
new file mode 100644
index 000000000..afa677295
--- /dev/null
+++ b/hw/input/tsc2007.c
@@ -0,0 +1,251 @@
+/*
+ * TI TSC2007 touchscreen controller emulation for TomTom R-LINK.
+ *
+ * Copyright (c) 2026
+ *
+ * This file is licensed under the GNU GPL, version 2 or later.
+ */
+
+#include "hw/i2c/i2c.h"
+#include "ui/console.h"
+#include "ui/input.h"
+
+#define TYPE_TSC2007 "tsc2007"
+#define TSC2007(obj) OBJECT_CHECK(TSC2007State, (obj), TYPE_TSC2007)
+
+#define TSC2007_MEASURE_TEMP0    0x00
+#define TSC2007_MEASURE_AUX      0x20
+#define TSC2007_MEASURE_TEMP1    0x40
+#define TSC2007_MEASURE_X        0xc0
+#define TSC2007_MEASURE_Y        0xd0
+#define TSC2007_MEASURE_Z1       0xe0
+#define TSC2007_MEASURE_Z2       0xf0
+
+#define TSC2007_MAX_12BIT        4095
+#define RLINK_LCD_WIDTH          800
+#define RLINK_LCD_HEIGHT         480
+
+/* Factory calibration consumed by /system/bin/readcal. */
+#define CAL_A                    (-13517)
+#define CAL_B                    26
+#define CAL_C                    53414312
+#define CAL_D                    44
+#define CAL_E                    (-8383)
+#define CAL_F                    32074952
+#define CAL_SCALE                65536
+
+typedef struct TSC2007State {
+    I2CSlave parent_obj;
+    qemu_irq penirq;
+
+    uint8_t command;
+    int rx_byte;
+    int x;
+    int y;
+    int pressed;
+} TSC2007State;
+
+static int tsc2007_clamp_12bit(int value)
+{
+    if (value < 1) {
+        return 1;
+    }
+    if (value >= TSC2007_MAX_12BIT) {
+        return TSC2007_MAX_12BIT - 1;
+    }
+    return value;
+}
+
+static void tsc2007_set_position(TSC2007State *s, int x, int y)
+{
+    int screen_x, screen_y;
+    int64_t rhs_x, rhs_y, determinant;
+    int64_t raw_x, raw_y;
+
+    x = MAX(0, MIN(x, INPUT_EVENT_ABS_SIZE - 1));
+    y = MAX(0, MIN(y, INPUT_EVENT_ABS_SIZE - 1));
+    screen_x = (int64_t)x * (RLINK_LCD_WIDTH - 1) /
+               (INPUT_EVENT_ABS_SIZE - 1);
+    screen_y = (int64_t)y * (RLINK_LCD_HEIGHT - 1) /
+               (INPUT_EVENT_ABS_SIZE - 1);
+
+    /* Invert tslib's affine transform so a VNC pixel maps back to the raw
+     * 12-bit sample expected by the production calibration. */
+    rhs_x = (int64_t)screen_x * CAL_SCALE - CAL_C;
+    rhs_y = (int64_t)screen_y * CAL_SCALE - CAL_F;
+    determinant = (int64_t)CAL_A * CAL_E - (int64_t)CAL_B * CAL_D;
+    raw_x = (rhs_x * CAL_E - (int64_t)CAL_B * rhs_y) / determinant;
+    raw_y = ((int64_t)CAL_A * rhs_y - (int64_t)CAL_D * rhs_x) /
+            determinant;
+
+    s->x = tsc2007_clamp_12bit(raw_x);
+    s->y = tsc2007_clamp_12bit(raw_y);
+}
+
+static void tsc2007_update_penirq(TSC2007State *s)
+{
+    /* TSC2007 PENIRQ and Strasbourg GPIO54 are active low. */
+    qemu_set_irq(s->penirq, !s->pressed);
+}
+
+static void tsc2007_touch_event(void *opaque, int x, int y, int dz,
+                                int buttons_state)
+{
+    TSC2007State *s = opaque;
+    int pressed = !!(buttons_state & MOUSE_EVENT_LBUTTON);
+
+    if (pressed) {
+        tsc2007_set_position(s, x, y);
+    }
+    if (pressed != s->pressed) {
+        s->pressed = pressed;
+        tsc2007_update_penirq(s);
+    }
+}
+
+static uint16_t tsc2007_pressure_z1(TSC2007State *s)
+{
+    int64_t x_resistance, y_resistance, denominator;
+    int z1;
+
+    if (!s->pressed) {
+        return 0;
+    }
+
+    /* Select Z1 so the firmware's resistance formula yields approximately
+     * 1000 ohms throughout the panel, safely below its max_rt of 3500. */
+    x_resistance = ((int64_t)1250 * s->x + 2047) >> 12;
+    y_resistance = ((int64_t)350 * (4096 - s->y) + 2047) >> 12;
+    denominator = 1000 + y_resistance + x_resistance;
+    z1 = denominator ? (4096 * x_resistance) / denominator : 1;
+    return tsc2007_clamp_12bit(z1);
+}
+
+static uint16_t tsc2007_sample(TSC2007State *s)
+{
+    if (!s->pressed && (s->command & 0xf0) >= TSC2007_MEASURE_X) {
+        return 0;
+    }
+
+    switch (s->command & 0xf0) {
+    case TSC2007_MEASURE_X:
+        return s->x;
+    case TSC2007_MEASURE_Y:
+        return s->y;
+    case TSC2007_MEASURE_Z1:
+        return tsc2007_pressure_z1(s);
+    case TSC2007_MEASURE_Z2:
+        return s->pressed ? TSC2007_MAX_12BIT : 0;
+    case TSC2007_MEASURE_TEMP0:
+        /* Command 0 is power-down; READ_TEMP0 has ADC power bits set. */
+        return s->command ? 1000 : 0;
+    case TSC2007_MEASURE_TEMP1:
+        return 1264;
+    case TSC2007_MEASURE_AUX:
+        return 2048;
+    default:
+        return 0;
+    }
+}
+
+static int tsc2007_rx(I2CSlave *i2c)
+{
+    TSC2007State *s = TSC2007(i2c);
+    uint16_t sample = tsc2007_sample(s);
+
+    /* Wire format is D11..D4 followed by D3..D0 in the high nibble. */
+    if (s->rx_byte++ == 0) {
+        return sample >> 4;
+    }
+    return (sample & 0x0f) << 4;
+}
+
+static int tsc2007_tx(I2CSlave *i2c, uint8_t data)
+{
+    TSC2007State *s = TSC2007(i2c);
+
+    s->command = data;
+    return 0;
+}
+
+static void tsc2007_event(I2CSlave *i2c, enum i2c_event event)
+{
+    TSC2007State *s = TSC2007(i2c);
+
+    if (event == I2C_START_RECV) {
+        s->rx_byte = 0;
+    }
+}
+
+static void tsc2007_reset(DeviceState *dev)
+{
+    TSC2007State *s = TSC2007(dev);
+
+    s->command = 0;
+    s->rx_byte = 0;
+    s->pressed = 0;
+    tsc2007_set_position(s, INPUT_EVENT_ABS_SIZE / 2,
+                         INPUT_EVENT_ABS_SIZE / 2);
+    tsc2007_update_penirq(s);
+}
+
+static int tsc2007_post_load(void *opaque, int version_id)
+{
+    TSC2007State *s = opaque;
+
+    s->pressed = 0;
+    tsc2007_update_penirq(s);
+    return 0;
+}
